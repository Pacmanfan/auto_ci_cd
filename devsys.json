{
  "_comment": [
    "Project configuration of the development-control system (ADR-000199).",
    "Every key not set here takes its default: python3 scripts/devsys_config.py prints the effective values,",
    "docs/process/configuration.md documents each setting. Keys starting with '_' are ignored.",
    "This file is a protected artifact: change it through a PROCESS-CHANGE request."
  ],
  "schema": 1,
  "project": {
    "name": "auto_ci_cd",
    "source_roots": []
  },
  "paths": {
    "scratch": "tmp",
    "build_dir": "build/debug",
    "crash_dumps": "log/dump"
  },
  "build": {
    "system": "none"
  },
  "tests": {
    "selection": "auto",
    "no_test_patterns": [
      "docs/*",
      "*.md",
      "requests/*",
      "work/*",
      "evidence/*",
      ".agent/*",
      "LICENSE",
      "readme.md",
      "*.pro.user",
      "*.pro.user.*",
      ".gitignore",
      ".vscode/*",
      ".claude/*",
      "*/__pycache__/*",
      "*.pyc"
    ]
  },
  "completion": {
    "min_tier": "t2"
  },
  "invariants": [],
  "_examples": {
    "build_cmake": {
      "system": "cmake",
      "source_dir": ".",
      "build_dir": "build/debug"
    },
    "build_make": {
      "system": "make"
    },
    "build_custom": {
      "system": "custom",
      "build": [
        "./build.sh",
        "--out",
        "{build_dir}"
      ],
      "clean": [
        "./build.sh",
        "--clean",
        "{build_dir}"
      ]
    },
    "invariants": [
      {
        "id": "core-ui-free",
        "kind": "forbid_pattern",
        "files": [
          "src/core/**"
        ],
        "pattern": "#include\\s*<Q",
        "message": "the core library stays UI-framework-free"
      },
      {
        "id": "layering",
        "kind": "layers",
        "layers": [
          {
            "name": "app",
            "files": [
              "src/app/**"
            ],
            "names": [
              "app/"
            ]
          },
          {
            "name": "core",
            "files": [
              "src/core/**"
            ],
            "names": [
              "core/"
            ]
          }
        ]
      }
    ],
    "binary_suite_globs_mode": {
      "id": "unit",
      "kind": "binary",
      "results": "junit",
      "binary": "tests/unit_tests",
      "sources": [
        "src/**",
        "tests/**"
      ],
      "groups": {
        "unit": {
          "tiers": [
            "t1"
          ],
          "expected_seconds": 30
        }
      }
    }
  },
  "workers": {
    "_comment": "ADR-000203. worker-01 runs the default agent (workers.agent); worker-02 the profile assigned below. Profiles and their flags: docs/process/agent-profiles.md.",
    "max_workers": 2,
    "isolation": "shared",
    "agent": {
      "command": [
        "claude",
        "-p",
        "--output-format",
        "stream-json",
        "--verbose",
        "--permission-mode",
        "auto",
        "--permission-prompts",
        "none",
        "--session-id",
        "{session_id}",
        "--name",
        "{name}",
        "--add-dir",
        "{attempt_dir}"
      ],
      "env_scrub": [
        "CLAUDECODE",
        "CLAUDE_CODE_CHILD_SESSION",
        "CLAUDE_CODE_SESSION_ID",
        "CLAUDE_PID",
        "CLAUDE_EFFORT",
        "CLAUDE_CODE_MESSAGING_SOCKET",
        "CLAUDE_CODE_MESSAGING_TOKEN",
        "CLAUDE_CODE_SESSION_ATTENDED",
        "CLAUDE_CODE_ENTRYPOINT",
        "CLAUDE_CODE_EXECPATH",
        "AI_AGENT"
      ],
      "rate_limit_patterns": [
        "usage limit",
        "rate limit",
        "limit reached"
      ]
    },
    "profiles": {
      "opencode": {
        "command": [
          "{python}",
          "{scripts}/workers/profiles/event_stream_adapter.py",
          "--session-id",
          "{session_id}",
          "--raw-log",
          "{attempt_dir}/raw.jsonl",
          "--",
          "opencode",
          "run",
          "--format",
          "json",
          "--auto",
          "--title",
          "{name}"
        ],
        "env_scrub": [],
        "rate_limit_patterns": [
          "usage limit",
          "rate limit",
          "limit reached",
          "quota"
        ]
      }
    },
    "assign": {
      "worker-02": "opencode"
    }
  }
}
